# ============================================================
# YT-AGENT-AI — Variables de entorno para desarrollo
# ============================================================
# Copia este archivo como `.env` y completa los valores:
#
#   cp .env.example .env
#
# NOTA: la API key de Google Gemini NO va aquí. Cada usuario la
# ingresa en el sidebar de Streamlit (campo "Gemini API Key") o la
# envía en el payload del endpoint REST (`gemini_api_key`).
# ============================================================

# --- Transcripción (REQUERIDO) ---
# AssemblyAI: convierte el audio del video a texto.
# Sin esta clave fallan app.py y el endpoint /api/generate-report/.
# Consigue la tuya en: https://www.assemblyai.com/
AAI_API_KEY=tu_api_key_assemblyai

# --- Base de datos PostgreSQL (REQUERIDO) ---
# Desarrollo local con Docker Compose:
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres
DB_HOST=db
DB_PORT=5432
# NOTA: ai_translation/settings.py fija PORT en '5432'.
# DB_PORT se documenta aquí por convención; el valor efectivo es 5432.

# --- Django ---
# Clave secreta (tiene valor por defecto en settings.py, cámbiala en producción)
SECRET_KEY=django-insecure-cambia-esto-en-produccion
# Modo debug: True para desarrollo, False para producción (por defecto True)
DEBUG=True
